// Instruction memory image for main_test.v (one 32-bit word per line)
00802483 // 0x00: lw x9,  8(x0)   -> x9  = mem[0x08] = 0x10 (a pointer)
FFC4A303 // 0x04: lw x6, -4(x9)   -> x6  = mem[0x0C]        (negative offset)
0004A383 // 0x08: lw x7,  0(x9)   -> x7  = mem[0x10]
0004A003 // 0x0C: lw x0,  0(x9)   -> write to x0 must be ignored
0044A503 // 0x10: lw x10, 4(x9)   -> x10 = mem[0x14]
@3F 00000000 // pad last word so iverilog sees the full 64-word range
